# Telegram BotFather token. Keep this secret and never commit it.
BOT_TOKEN=

# Optional: restrict commands and alerts to your Telegram chat ID(s).
# Find your ID by using a trusted Telegram ID bot, then set comma-separated IDs.
ALLOWED_CHAT_IDS=

# Paper-only safety settings.
PAPER_CAPITAL=10000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_CONSECUTIVE_LOSSES=2
MAX_PAPER_TRADES=6
MIN_SCORE=80

# Market/data settings.
WATCHLIST=NIFTY,BANKNIFTY,INFY,TCS,HDFCBANK,RELIANCE
SCAN_INTERVAL_SECONDS=900
MAX_CANDLE_AGE_MINUTES=35
NOTIFICATION_MODE=strong_only
ALLOW_OUTSIDE_HOURS_ANALYSIS=true
DB_PATH=10x_think_pro.sqlite3
LOG_LEVEL=INFO